# ShipFix v2 — local environment template. Copy to .env and fill in.
# Secrets are NEVER committed. This file lists names only.

# Control plane (API + worker both read DATABASE_URL)
DATABASE_URL=postgres://shipfix:shipfix@localhost:5432/shipfix
# Optional local override. Hosted platforms like Render usually provide PORT,
# and the API uses PORT automatically when API_PORT is not set.
API_PORT=4000
# Allowed browser origin for CORS/SSE (the web app). "*" is fine for local dev.
WEB_ORIGIN=*

# Temporal (local dev server: `temporal server start-dev`)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# In local dev, the generic "shipfix" queue is automatically scoped to the
# configured DATABASE_URL so stale workers on another DB cannot pick up runs.
# Set a custom value only when you intentionally manage the same queue in both
# API and worker.
TEMPORAL_TASK_QUEUE=shipfix

# Web app -> API base URL (Next.js, must be NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication. Production must use AUTH_MODE=clerk. AUTH_MODE=dev is local
# development only and is rejected when NODE_ENV=production.
AUTH_MODE=clerk
NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Admin endpoints require X-ShipFix-Admin-Token or Authorization: Bearer <token>.
SHIPFIX_ADMIN_TOKEN=

# SecretVault master key (base64, 32 bytes). Encrypts connected provider
# credentials + provisioned connection strings (envelope encryption; KMS later).
# Required by the API to connect a provider and by the worker to provision.
# Generate one: `openssl rand -base64 32`
SHIPFIX_MASTER_KEY=

# LLM gateway (read by the worker for `plan` runs). The planner has no mock
# fallback — these MUST be set to generate a deployment plan. Put them in this
# repo-root .env or apps/worker/.env.local, then restart `pnpm dev:worker`.
#   LLM_PROVIDER: openai | anthropic | gemini
#   LLM_MODEL:    e.g. gpt-4o-mini | claude-3-5-sonnet-latest | gemini-1.5-pro
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Backward-compatible fallback for older local env files. Prefer the
# provider-specific variables above for clearer diagnostics.
# LLM_API_KEY=

# Neon provisioning (API + worker). Neon requires an organization id when
# creating projects. Find it in Neon organization settings.
NEON_ORG_ID=
# Backward-compatible alias; prefer NEON_ORG_ID.
# NEON_ORGANIZATION_ID=

# Alpha safety limits (backend-enforced)
# Local/dev defaults are intentionally higher for alpha testing. Production
# remains backend-enforced and should set explicit ALPHA_* values.
ALPHA_MAX_DEPLOY_RUNS_PER_USER_PER_DAY=50
ALPHA_MAX_PLAN_ANALYZE_RUNS_PER_USER_PER_DAY=100
ALPHA_MAX_ACTIVE_DEPLOY_RUNS_PER_USER=3
ALPHA_MAX_LLM_CALLS_PER_RUN=10
ALPHA_MAX_LLM_CALLS_PER_USER_PER_DAY=200
# Repair has its own per-run model budget (default 4 in production, 6 in dev).
# ALPHA_MAX_REPAIR_LLM_CALLS_PER_RUN=6
# Set to "off" to disable automatic repair of failed deploys.
# SHIPFIX_AUTOFIX=on
ALPHA_RATE_LIMIT_WINDOW_MS=60000
ALPHA_MAX_RUN_STARTS_PER_IP_WINDOW=100
LLM_MAX_PROMPT_CHARS=120000

# GitHub App (private repos + push auto-deploy + fix pull requests). PEM may use \n escapes or base64.
# Repository permissions: Contents read & write, Pull requests read & write, Metadata read.
# Subscribe to the "Push" event. Without write access ShipFix shows tested fixes as a diff instead.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# Required to link installations to ShipFix users (enable "Request user authorization
# (OAuth) during installation" and set the Setup URL to <web>/github/callback).
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# KMS_KEY_ID=

# Sandbox for untrusted repo code (worker). "e2b" is required in production;
# "local" runs on the host and is dev-only. Defaults to e2b when E2B_API_KEY is set.
# SHIPFIX_SANDBOX=local
# E2B_API_KEY=
# E2B_TEMPLATE=base
# Extra comma-separated egress hosts for sandboxes (e.g. a private npm mirror).
# SHIPFIX_SANDBOX_EGRESS_ALLOW=

# Provider login (optional). When set, the Providers page offers "Connect with ..."
# Register this redirect URL with each provider: <web origin>/providers/callback
# Vercel uses an integration (long-lived token). Neon and Supabase use OAuth and are refreshed before deploy.
# Render and Upstash stay pasted keys: their deploy APIs do not issue a token through this login.
# VERCEL_OAUTH_CLIENT_ID=
# VERCEL_OAUTH_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=
# NEON_OAUTH_CLIENT_ID=
# NEON_OAUTH_CLIENT_SECRET=
# SUPABASE_OAUTH_CLIENT_ID=
# SUPABASE_OAUTH_CLIENT_SECRET=
# Clerk: enable the GitHub social connection so the sign-in screen can offer "Continue with GitHub".

# MCP server (packages/mcp). Point Cursor or Claude Code at packages/mcp/plugins/*.mcp.json.
# CLI: pnpm --filter @shipfix/cli exec shipfix deploy owner/repo
# GitHub Action: packages/cli/action.yml (needs Node 22). It waits for the run.
# Use SHIPFIX_DEV_USER with AUTH_MODE=dev, or SHIPFIX_TOKEN as a Clerk bearer. Never commit the token.
# SHIPFIX_API_URL=http://localhost:4000
# SHIPFIX_TOKEN=
# SHIPFIX_DEV_USER=local-dev
# Guardian posts here when a live health check fails, a spend cap is passed, or usage jumps week over week. The value is a Slack incoming webhook and is never logged.
# GUARDIAN_SLACK_WEBHOOK=
# Stripe. Guardian is $29 per app per month. Checkout stays off until all three are set, and no card is charged while they are empty.
# Agency has no checkout in this build. Create the Guardian price in the Stripe dashboard and paste its price id.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_GUARDIAN_PRICE_ID=
