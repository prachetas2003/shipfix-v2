FROM node:22-bookworm-slim

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && curl -sSf https://temporal.download/cli.sh | sh \
  && ln -sf /root/.temporalio/bin/temporal /usr/local/bin/temporal

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile \
  && pnpm --filter @shipfix/api build \
  && pnpm --filter @shipfix/worker build

ENV NODE_ENV=production
ENV TEMPORAL_ADDRESS=127.0.0.1:7233
ENV TEMPORAL_NAMESPACE=default
ENV TEMPORAL_TASK_QUEUE=shipfix-prod
ENV SHIPFIX_SANDBOX=e2b
ENV AUTH_MODE=clerk

EXPOSE 4000

CMD ["sh", "scripts/free-web.sh"]
